# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/edtech_matrix

# JWT signing secret (required — app will not sign tokens without this)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Server port
PORT=3000

# Email Configuration - SMTP (Set SMTP_ENABLE=true to use SMTP)
# For local development, you can disable email (SMTP_ENABLE=false) — links are logged to the server console
SMTP_ENABLE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER_EMAIL=
SMTP_PASS=
SMTP_FROM=

# Optional: real email for super admin (defaults to SMTP_USER_EMAIL)
# ADMIN_EMAIL=you@example.com

# Base URL used in password-reset / invite email links (no trailing slash)
# Example: http://localhost:3000  or  https://your-domain.com
APP_URL=http://localhost:3000

# Runtime logs (auto-created daily):
#   logs/yyyy-mm-dd.log  — all API + email logs for that day
# Files older than 14 days are deleted automatically


# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
