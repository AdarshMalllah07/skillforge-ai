{
  "name": "skillforge-ai",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "seed": "tsx -e \"import('dotenv/config'); import('./server/db.ts').then(m => m.connectDB()).then(() => import('./server/seed.ts')).then(s => s.seedDatabase()).then(() => process.exit(0))\"",
    "create-super-admin": "tsx -e \"import('dotenv/config'); import('./server/db.ts').then(m => m.connectDB()).then(() => import('./server/seed.ts')).then(s => s.ensureSuperAdmin()).then(() => process.exit(0))\"",
    "clean": "rm -rf .next dist"
  },
