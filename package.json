    "mongoose": "^9.9.1",
    "motion": "^12.23.24",
    "next": "^15.5.2",
    "nodemailer": "^9.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
